// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Log {
  id Int @id @default(autoincrement())
  timestamp DateTime @default(now())
  logLevel String
  logMessage String
  archived Boolean
  source String @default("manual") // "manual" (POST /api/logs), "monitor" (threshold alerts), "action" (fix script runs)
  actionId String? // registry id of the action that ran; audit fields are null for non-action logs
  success Boolean?
  durationMs Int?
}

// One metrics sample, written by the ticker every few seconds.
// Byte values are Float: SQLite REAL holds integers exactly up to 2^53 and avoids BigInt in JSON.
model Sample {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  cpuTotal     Float    // percent, 0-100
  cpuTemp      Float?   // celsius; null when the sensor is not readable (common on Windows)
  ramUsed      Float    // bytes
  ramTotal     Float    // bytes
  diskReadBps  Float?   // bytes per second; null when not measurable yet
  diskWriteBps Float?
  netRxBps     Float?
  netTxBps     Float?

  @@index([createdAt])
}

model AppConfig {
  id    Int     @id @default(autoincrement())
  key   String  @unique // "THEME_COLOR", "DASHBOARD_NAME"
  value String
  type  String  // 'string', 'number', o 'boolean'
}