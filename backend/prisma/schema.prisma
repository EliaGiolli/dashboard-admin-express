// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Log {
  id Int @id @default(autoincrement())
  timestamp DateTime @default(now())
  logLevel String
  logMessage String
  archived Boolean
}

// One metrics sample, written by the ticker every few seconds.
// Byte values are Float: SQLite REAL holds integers exactly up to 2^53 and avoids BigInt in JSON.
model Sample {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  cpuTotal     Float    // percent, 0-100
  cpuTemp      Float?   // celsius; null when the sensor is not readable (common on Windows)
  ramUsed      Float    // bytes
  ramTotal     Float    // bytes
  diskReadBps  Float    // bytes per second
  diskWriteBps Float
  netRxBps     Float
  netTxBps     Float

  @@index([createdAt])
}

model AppConfig {
  id    Int     @id @default(autoincrement())
  key   String  @unique // "THEME_COLOR", "DASHBOARD_NAME"
  value String
  type  String  // 'string', 'number', o 'boolean'
}